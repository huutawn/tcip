{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=identity;Username=identity;Password=identity"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Jwt": {
    "Issuer": "identity-service",
    "Audience": "identity-service",
    "Key": "super_secret_jwt_key_that_is_at_least_32_bytes_long_123456",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Notifications": {
    "SignalRConcurrency": 64
  },
  "ReminderScheduler": {
    "MaxBatchesPerRun": 10
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "ReminderDueTopic": "calendar.reminder-due.v2",
    "NotificationBatchTopic": "calendar.notification-batch.v1",
    "AudienceResolverGroup": "calendar.audience-resolver.v2",
    "NotificationBatchDeliveryGroup": "calendar.notification-batch-delivery.v1"
  }
}
